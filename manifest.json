{
  "manifest_version": 3,
  "name": "ShopEnginX",
  "version": "1.0.0",
  "description": "AI-powered video and image creation for e-commerce",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://labs.google.com/*",
    "https://aitestkitchen.withgoogle.com/*",
    "https://*.withgoogle.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*"
  ],
  "action": {
    "default_title": "ShopEnginX"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/*", "https://tiktok.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "public/icon.svg"
  }
}
